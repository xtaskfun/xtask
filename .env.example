# Get a free project id at https://cloud.reown.com (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# --- Escrow (see contracts/README.md) ---
# Public: where the escrow contract is deployed
NEXT_PUBLIC_ESCROW_ADDRESS=
# 84532 = Base Sepolia (testnet), 8453 = Base mainnet
NEXT_PUBLIC_ESCROW_CHAIN_ID=84532

# Server only — NEVER prefix with NEXT_PUBLIC_. Private key of the claim signer wallet.
SIGNER_PRIVATE_KEY=
# Optional custom RPC for the server
ESCROW_RPC_URL=
# Testnet only! "off" skips X login + verification: anyone can claim. Leave empty.
CLAIM_VERIFICATION=

# --- X (Twitter) login & verification ---
# From developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Random string, 32+ characters (encrypts the login cookie). e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Your public site URL, used for the OAuth callback (must match the X app settings)
NEXT_PUBLIC_SITE_URL=https://xtask.fun
# Anti-bot rules (optional)
X_MIN_ACCOUNT_AGE_DAYS=30
X_MIN_FOLLOWERS=5

# --- Database (Upstash Redis) ---
# Vercel → Storage / Marketplace → Upstash Redis sets KV_REST_API_URL + KV_REST_API_TOKEN automatically.
# Or set these from console.upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
