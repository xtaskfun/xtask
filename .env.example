# Wallet login (Privy). Defaults to the xtask.fun app id; set your own from dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: your own WalletConnect project id (https://cloud.reown.com) for mobile wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Escrow (see contracts/README.md) ---
# Public: where the escrow contract is deployed
NEXT_PUBLIC_ESCROW_ADDRESS=
# 84532 = Base Sepolia (testnet), 8453 = Base mainnet
NEXT_PUBLIC_ESCROW_CHAIN_ID=84532
# More networks (one escrow each, same signer)
NEXT_PUBLIC_ESCROW_ADDRESS_BASE=
NEXT_PUBLIC_ESCROW_ADDRESS_ROBINHOOD=
NEXT_PUBLIC_ESCROW_ADDRESS_BASE_SEPOLIA=

# Server only — NEVER prefix with NEXT_PUBLIC_. Private key of the claim signer wallet.
SIGNER_PRIVATE_KEY=
# Optional custom RPC for the server
ESCROW_RPC_URL=
# Testnet only! "off" skips X login + verification: anyone can claim. Leave empty.
CLAIM_VERIFICATION=

# --- Verification mode ---
# empty / "none": wallet only, no check (anyone can claim once per wallet)
# "x": require X login + verification through the X API (needs the X_* settings below)
NEXT_PUBLIC_VERIFICATION_MODE=

# --- X (Twitter) login & verification (mode "x" only) ---
# From developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Random string, 32+ characters (encrypts the login cookie). e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Your public site URL, used for the OAuth callback (must match the X app settings)
NEXT_PUBLIC_SITE_URL=https://xtask.fun
# Anti-bot rules (optional)
X_MIN_ACCOUNT_AGE_DAYS=0
X_MIN_FOLLOWERS=0

# --- Database (Upstash Redis) ---
# Vercel → Storage / Marketplace → Upstash Redis sets KV_REST_API_URL + KV_REST_API_TOKEN automatically.
# Or set these from console.upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Automatic refunds ---
# Wallet that sends refunds for ended tasks and pays the gas (needs a little ETH on each network).
# Defaults to SIGNER_PRIVATE_KEY when empty.
KEEPER_PRIVATE_KEY=
# Optional: protects /api/cron/refunds (Vercel Cron sends it automatically when set)
CRON_SECRET=

# --- Anti-abuse ---
# How many different wallets may claim the same task from one IP address (default 1).
# Raise it (e.g. 2-3) if people on shared mobile/WiFi connections get blocked.
CLAIM_LIMIT_PER_IP=1
